# Only needed to regenerate audio; playing the game needs none of these.
# Checkout of the ZUN-style arrangement toolkit (github.com/grapeot/zun-music-skill)
ZUN_MUSIC_SKILL_DIR=/path/to/zun-music-skill
# NeoTHFont SoundFont (musical-artifacts.com artifact 6614)
ZUN_MUSIC_SOUNDFONT=/path/to/neothfont.sf2
# MIDI cue renderer used for the sound effects
SCORE_CUE_SCRIPT=/path/to/score_cue.py
